# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Gemini model used for generation (optional; defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated origins allowed by the backend CORS policy (optional)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Set to 0/false to disable BM25 and use pure vector retrieval (optional)
# ENABLE_BM25=1
